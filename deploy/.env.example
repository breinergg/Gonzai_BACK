# Copia este archivo a ".env" y completa los valores. NO subas ".env" a git.

# --- Base de datos ---
POSTGRES_PASSWORD=cambia-esta-clave

# --- Seguridad ---
# Mínimo 32 caracteres aleatorios. Genera una con:  openssl rand -base64 48
JWT_KEY=

# --- IA (Google Gemini) ---
GEMINI_API_KEY=

# --- Primer administrador (solo se crea si no hay usuarios) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@midominio.com
ADMIN_PASSWORD=
# Tras el primer inicio de sesión cambia la contraseña y puedes vaciar ADMIN_PASSWORD.

# --- Dominio público (con el TLS ya resuelto por tu proxy/hosting) ---
PUBLIC_URL=https://gonzai.midominio.com
PUBLIC_HOST=gonzai.midominio.com
WEB_PORT=80
# Número de proxies delante de nginx que añaden X-Forwarded-For (0 = solo nginx → déjalo en 1;
# si hay otro proxy delante, súbelo a 2).
FORWARD_LIMIT=1

# --- Correo para enviar comprobantes (opcional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
