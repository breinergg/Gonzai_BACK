# Termina el TLS y reenvía todo a nginx (servicio "web"), que a su vez sirve el Angular
# y hace proxy de /api/ hacia la API (servicio "api"). PUBLIC_HOST sale del .env.
#
# Con un dominio real que ya apunte a este servidor, Caddy obtiene y renueva solo el
# certificado de Let's Encrypt. Con una IP o "localhost", sirve en HTTP sin pedir certificado.
{$PUBLIC_HOST} {
	encode gzip

	reverse_proxy web:80
}
